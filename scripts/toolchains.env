# Single source of truth for pinned tool versions. Sourced by scripts;
# docs/VERIFICATION.md mirrors these values for readers.
#
# To bump Verus: pick a non-rolling release, set RUST_TOOLCHAIN to the
# toolchain in its version.json, update vstd in crates' Cargo.toml to the
# matching version, and update rust-toolchain.toml.

# Stable Rust for building, clippy and Verus. Must equal rust-toolchain.toml.
RUST_TOOLCHAIN=1.98.1

# Verus release tag (github.com/verus-lang/verus/releases, tag release/<this>).
VERUS_VERSION=0.2026.10.04.426d8b0
# vstd crate version matching VERUS_VERSION.
VSTD_VERSION=0.0.0-2026-10-04-0306

# Kani verifier (crates.io kani-verifier). `cargo kani setup` installs
# KANI_NIGHTLY itself.
KANI_VERSION=0.68.0
KANI_NIGHTLY=nightly-2026-08-21

# Miri runs on the same nightly as Kani, so only one nightly is installed.
MIRI_NIGHTLY=nightly-2026-08-21
